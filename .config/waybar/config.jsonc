{
 "layer": "top",
    "position": "bottom",
    "width": 1652,
    "height": 30,
    "margin-top": 6,
    "margin-left": 7,
    "margin-right": 5,
    "margin-bottom": 0,
    "exclusive": true,
    "modules-left": [
        "custom/notify",
        "custom/spacer",
        "custom/mango_tags1",
        "custom/sep1",
        "custom/mango_tags2",
        "custom/sep2",
        "custom/mango_tags3",
        "custom/sep3",
        "custom/mango_tags4",
        "custom/sep4",
        "custom/mango_tags5",
        "custom/sep5",
        "custom/mango_tags6",
        "custom/sep6",
        "custom/mango_tags7",
        "custom/sep7",
        "custom/mango_tags8",
        "custom/sep8",
        "custom/mango_tags9"
    ],
    "modules-center": [
        "custom/mango_focused"
    ],
    "modules-right": [
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "network",
        "custom/sep",
        "backlight",
        "custom/sep",
        "custom/tuned",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "battery",
        "custom/sep",
        "clock"
    ],
    "custom/mango_tags1": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 1",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags2": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 2",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags3": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 3",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags4": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 4",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags5": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 5",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags6": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 6",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags7": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 7",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags8": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 8",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags9": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 9",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_focused": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar focused",
        "return-type": "json",
        "tooltip": true
    },
    "custom/sep1": {
        "format": "|",
        "color": "#565f77"
    },
    "custom/sep2": {
        "format": "|",
        "color": "#565f77"
    },
    "custom/sep3": {
        "format": "|",
        "color": "#565f77"
    },
    "custom/sep4": {
        "format": "|",
        "color": "#565f77"
    },
    "custom/sep5": {
        "format": "|",
        "color": "#565f77"
    },
    "custom/sep6": {
        "format": "|",
        "color": "#565f77"
    },
    "custom/sep7": {
        "format": "|",
        "color": "#565f77"
    },
    "custom/sep8": {
        "format": "|",
        "color": "#565f77"
    },
    "custom/sep": {
        "format": "|",
        "color": "#565f77"
    },
    "custom/spacer": {
        "format": "  "
    },
    "network": {
        "format-wifi": "<span color='#7aa2f7'>WIFI</span>",
        "format-ethernet": "<span color='#9ece6a'>ETH</span>",
        "format-disconnected": "<span color='#f7768e'>OFFLINE</span>",
        "tooltip-format": "{ifname} | {essid} | {signalStrength}% | {ipaddr}",
        "on-click": "nmcli connection show",
        "interval": 5
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "<span color='#7aa2f7'>BRT</span> {percent}%",
        "tooltip-format": "Brightness {percent}%",
        "on-scroll-up": "/home/honken/.config/mango/scripts/brightness.sh up",
        "on-scroll-down": "/home/honken/.config/mango/scripts/brightness.sh down"
    },
    "custom/tuned": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/tuned_status.sh",
        "return-type": "json",
        "signal": 8,
        "on-click": "/home/honken/.config/waybar/scripts/tuned_toggle.sh",
        "tooltip": true
    },
    "pulseaudio": {
        "format": "<span color='#7aa2f7'>VOL</span> {volume}%",
        "format-muted": "<span color='#565f77'>MUTED</span>",
        "format-icons": {
            "headphone": "\uF025",
            "hands-free": "\uF025",
            "headset": "\uF025",
            "phone": "\uF095",
            "portable": "\uF025",
            "car": "\uF1B9",
            "default": ["\uF026", "\uF027", "\uF028"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },
    "custom/notify": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mako_count.sh",
        "return-type": "json",
        "on-click": "makoctl menu",
        "on-click-right": "makoctl dismiss-all",
        "tooltip": true
    },
    "cpu": {
        "format": "<span color='#7aa2f7'>CPU</span> {usage}%",
        "tooltip-format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "<span color='#7aa2f7'>RAM</span> {}%",
        "tooltip-format": "MEM {percentage}%  {used} / {total}",
        "interval": 2
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span color='#7aa2f7'>BAT</span> {capacity}%",
        "format-charging": "<span color='#7aa2f7'>BAT</span> {capacity}%",
        "format-plugged": "<span color='#7aa2f7'>BAT</span> {capacity}%",
        "interval": 30
    },
    "clock": {
        "format": "<span color='#7aa2f7'>TIME</span> {:%H:%M}",
        "format-alt": "<span color='#7aa2f7'>TIME</span> {:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "{:%A, %d %B %Y}",
        "interval": 1
    }
}