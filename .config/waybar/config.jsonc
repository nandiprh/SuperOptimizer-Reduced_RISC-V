{
"layer": "top",
    "position": "top",
    "width": 1600,
    "height": 30,
    "margin-top": 6,
    "margin-left": 7,
    "margin-right": 7,
    "margin-bottom": 0,
    "exclusive": true,
    "modules-left": [
        "custom/notify",
        "custom/spacer",
        "custom/mango_tags1",
        "custom/sep1",
        "custom/mango_tags2",
        "custom/sep2",
        "custom/mango_tags3",
        "custom/sep3",
        "custom/mango_tags4",
        "custom/sep4",
        "custom/mango_tags5",
        "custom/sep5",
        "custom/mango_tags6",
        "custom/sep6",
        "custom/mango_tags7",
        "custom/sep7",
        "custom/mango_tags8",
        "custom/sep8",
        "custom/mango_tags9"
    ],
    "modules-center": [
        "custom/mango_focused"
    ],
    "modules-right": [
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "custom/net",
        "custom/sep",
        "custom/tuned",
        "pulseaudio",
        "custom/sep",
        "battery",
        "custom/sep",
        "clock"
    ],
    "custom/mango_tags1": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 1",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags2": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 2",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags3": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 3",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags4": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 4",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags5": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 5",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags6": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 6",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags7": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 7",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags8": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 8",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_tags9": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar tag 9",
        "return-type": "json",
        "tooltip": true
    },
    "custom/mango_focused": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/mangobar focused",
        "return-type": "json",
        "tooltip": true
    },
    "custom/sep1": {
        "format": "|",
        "color": "#707880"
    },
    "custom/sep2": {
        "format": "|",
        "color": "#707880"
    },
    "custom/sep3": {
        "format": "|",
        "color": "#707880"
    },
    "custom/sep4": {
        "format": "|",
        "color": "#707880"
    },
    "custom/sep5": {
        "format": "|",
        "color": "#707880"
    },
    "custom/sep6": {
        "format": "|",
        "color": "#707880"
    },
    "custom/sep7": {
        "format": "|",
        "color": "#707880"
    },
    "custom/sep8": {
        "format": "|",
        "color": "#707880"
    },
    "custom/sep": {
        "format": "|",
        "color": "#707880"
    },
    "custom/spacer": {
        "format": "  "
    },
    "custom/net": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/net_status.sh",
        "return-type": "json",
        "tooltip": true
    },
    "custom/tuned": {
        "format": "{}",
        "exec": "/home/honken/.config/waybar/scripts/tuned_status.sh",
        "return-type": "json",
        "signal": 8,
        "on-click": "/home/honken/.config/waybar/scripts/tuned_toggle.sh",
        "tooltip": true
    },
    "custom/notify": {
        "format": "{}",
        "exec": "swaync-client -swb",
        "return-type": "json",
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d",
        "tooltip": true
    },
    "cpu": {
        "format": "<span color='#F0C674'>CPU</span> {usage}%",
        "tooltip-format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "<span color='#F0C674'>RAM</span> {}%",
        "tooltip-format": "MEM {percentage}%  {used} / {total}",
        "interval": 2
    },
    "pulseaudio": {
        "format": "<span color='#F0C674'>VOL</span> {volume}%",
        "format-muted": "<span color='#707880'>MUTED</span>",
        "format-icons": {
            "headphone": "\uF025",
            "hands-free": "\uF025",
            "headset": "\uF025",
            "phone": "\uF095",
            "portable": "\uF025",
            "car": "\uF1B9",
            "default": ["\uF026", "\uF027", "\uF028"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span color='#F0C674'>BAT</span> {capacity}%",
        "format-charging": "<span color='#F0C674'>BAT</span> {capacity}%",
        "format-plugged": "<span color='#F0C674'>BAT</span> {capacity}%",
        "interval": 30
    },
    "clock": {
        "format": "<span color='#F0C674'>TIME</span> {:%H:%M}",
        "format-alt": "<span color='#F0C674'>TIME</span> {:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "{:%A, %d %B %Y}",
        "interval": 1
    }
}
