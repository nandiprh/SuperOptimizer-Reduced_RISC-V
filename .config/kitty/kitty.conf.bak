foreground #00ff00

font_size 12.0

cursor_trail 3
cursor_trail_decay 0.1 0.4

window_padding_width 14
background_opacity 0.90
background_blur 1

hide_window_decorations yes




# BEGIN_KITTY_FONTS
font_family      family="Nimbus Mono PS"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
